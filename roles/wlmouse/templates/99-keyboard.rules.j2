# Keyboard udev rules - Generated by Ansible
# For Keychron and VIA-compatible keyboards
# Generated on {{ ansible_date_time.iso8601 }}

{% if keychron_devices is defined and keychron_devices | length > 0 %}
# Keychron devices
{% for device in keychron_devices %}
# {{ device.name }}
SUBSYSTEM=="usb", ATTR{idVendor}=="{{ device.vendor }}", ATTR{idProduct}=="{{ device.product }}", MODE="0766", GROUP="plugdev"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="{{ device.vendor }}", ATTRS{idProduct}=="{{ device.product }}", MODE="0766", GROUP="plugdev"

{% endfor %}
{% endif %}

{% if via_devices is defined and via_devices | length > 0 %}
# Other VIA-compatible devices
{% for device in via_devices %}
# {{ device.name }}
SUBSYSTEM=="usb", ATTR{idVendor}=="{{ device.vendor }}", ATTR{idProduct}=="{{ device.product }}", MODE="0766", GROUP="plugdev"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="{{ device.vendor }}", ATTRS{idProduct}=="{{ device.product }}", MODE="0766", GROUP="plugdev"

{% endfor %}
{% endif %}

