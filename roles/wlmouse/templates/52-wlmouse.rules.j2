# udev rules for WLMouse
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Vendor ID: {{ wlmouse_id_vendor }}, Product ID: {{ wlmouse_id_product }}

# USB device rules
SUBSYSTEM=="usb", ATTR{idVendor}=="{{ wlmouse_id_vendor }}", ATTR{idProduct}=="{{ wlmouse_id_product }}", MODE="0766", GROUP="plugdev"

# HID device rules for raw access
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="{{ wlmouse_id_vendor }}", ATTRS{idProduct}=="{{ wlmouse_id_product }}", MODE="0766", GROUP="plugdev"
